{
  "manifest_version": 3,
  "name": "LinkedIn Floating Toolbar",
  "version": "0.1.0",
  "description": "Keep the article and newsletter formatting toolbar visible while writing on LinkedIn.",
  "permissions": ["storage"],
  "action": {
    "default_title": "LinkedIn Floating Toolbar",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
